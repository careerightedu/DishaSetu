rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      
      // Allow update only if they are not trying to maliciously upgrade their payment status to true
      allow update: if request.auth != null && request.auth.uid == userId && 
        (!('hasPaid' in request.resource.data) || 
         request.resource.data.hasPaid == false || 
         (resource != null && 'hasPaid' in resource.data && resource.data.hasPaid == true));
    }
    
    match /coupons/{couponId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
